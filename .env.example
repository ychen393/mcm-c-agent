APP_ENV=development
APP_NAME=MCM C Research Lab
LOG_LEVEL=INFO
LLM_PROVIDER=deepseek
LLM_MODEL=replace-with-model-id
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DATABASE_URL=postgresql+psycopg://mcm:mcm_dev_password@localhost:5432/mcm_research
CHECKPOINT_DATABASE_URL=postgresql://mcm:mcm_dev_password@localhost:5432/mcm_research
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./outputs
# Phase 2 Problem Analyst — leave false in CI; optional live structured LLM path
PROBLEM_ANALYST_USE_LLM=false
# Phase 4 Literature & Evidence — leave false in CI; live retrieval is a non-inventing stub
LITERATURE_LIVE_RETRIEVAL=false
# Corpus embeddings / retrieval (CI-safe defaults — no paid API keys required)
CORPUS_EMBEDDING_PROVIDER=hash
CORPUS_VECTOR_BACKEND=auto
CORPUS_EMBEDDING_RETRIEVAL=auto
# Optional real providers (only when explicitly enabled locally):
# CORPUS_EMBEDDING_PROVIDER=sentence_transformers
# CORPUS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CORPUS_EMBEDDING_PROVIDER=openai
# CORPUS_EMBEDDING_MODEL=text-embedding-3-small
# CORPUS_VECTOR_BACKEND=pgvector
# Phase 5 Research Strategy / Debate — leave false in CI; optional LLM is a non-inventing stub
RESEARCH_STRATEGY_USE_LLM=false
# Phase 7 Validation / Sensitivity — leave false in CI; optional LLM critique is a non-executing stub
VALIDATION_USE_LLM=false
# Phase 8 Paper Planner / LaTeX — leave false in CI; optional LLM outline is a non-executing stub
PAPER_USE_LLM=false
PROJECT_STORE_BACKEND=auto
